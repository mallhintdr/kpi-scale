NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/kpi_dashboard
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Redis: cache, job queue (BullMQ), rate limits shared across API instances. Leave empty to run without it.
REDIS_URL=redis://127.0.0.1:6379
# Run background workers inside the API process (true) or in a separate `npm run worker` process (false)
RUN_WORKER=true
MONGO_POOL=50
# Platform super-admin created on first start if none exists
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
