NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/kpi_dashboard
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Redis: cache, job queue (BullMQ), rate limits shared across API instances. Leave empty to run without it.
REDIS_URL=redis://127.0.0.1:6379
# Run background workers inside the API process (true) or in a separate `npm run worker` process (false)
RUN_WORKER=true
MONGO_POOL=50
# Platform super-admin created on first start if none exists
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# WhatsApp daily coaching: mock (log only, default) | wasender | cloud (Meta). See WHATSAPP_INTEGRATION.md
WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WASender webhook: https://<domain>/api/whatsapp/webhook?secret=<this value>
WHATSAPP_WEBHOOK_SECRET=
# Meta: approved utility template with one body variable (business-initiated messages)
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_TEMPLATE_LANG=en
WHATSAPP_RATE_PER_SEC=10

# Single-organisation mode (Board of Revenue only). Set false to enable the multi-organisation platform.
SINGLE_TENANT=true
DEFAULT_TENANT=bor-bahawalpur
